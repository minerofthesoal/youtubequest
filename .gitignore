build/
extern/
*.qmod

.idea/
.vs/
.vscode/

# Generated by `qpm restore` at the project root (see CMakeLists.txt) --
# regenerated on every restore, so don't commit these.
/extern.cmake
/qpm_defines.cmake

# Generated from mod.template.json by `qpm qmod manifest`, so that the
# dependency list and download URLs always match the versions actually
# resolved by the lockfile instead of a hand-maintained copy that silently
# rots when an upstream repo moves.
/mod.json

# qpm.shared.json is QPM's lockfile (like Cargo.lock / package-lock.json) --
# it MUST be committed, not ignored. QPM does an unlocked resolve when it
# can't find one and warns about it in CI.
