--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -94,18 +94,30 @@
       - name: Cache QPM dependencies
         uses: actions/cache@v4
         with:
-          # Best-effort cache location for restored packages; run
-          # `qpm config cache path` locally to confirm this on your machine
-          # if restores aren't getting any faster.
-          path: |
-            ~/.local/share/QPM
-            extern
+          # Only cache QPM's own package-download cache (content-addressed,
+          # safe to reuse). Do NOT cache `extern` here: it's restore's
+          # *output*, and letting `restore-keys` fall back to an
+          # older/partial cache entry can hand `qpm restore` a stale
+          # `extern/` it then treats as already-populated, silently
